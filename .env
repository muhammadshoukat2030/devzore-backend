# ======================================================
# MONGODB
# ======================================================
MONGODB_URI=mongodb://127.0.0.1:27017/devzore_blog
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devzore_blog

# ======================================================
# JWT
# ======================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ======================================================
# IMAGE STORAGE
# ======================================================
# Images are now stored locally in /public/uploads
# They are automatically compressed to WebP format
# No external service configuration needed!

# ======================================================
# SERVER
# ======================================================
PORT=5000
NODE_ENV=development

# ======================================================
# CORS Origins
# ======================================================
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

ADMIN_NAME=M Shoukat
ADMIN_EMAIL=admin@devzore.com
ADMIN_PASSWORD=Admin@123456
ADMIN_ROLE=admin
SETUP_ADMIN_KEY=MySecretKey123

# Production URLs:
# FRONTEND_URL=https://devzore.com
# ADMIN_URL=https://admin.devzore.com



# /api/auth/setup-admin?key=DevZoreSetup2026